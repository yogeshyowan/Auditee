# =============================================================================
# Auditee — Hetzner / Docker deployment configuration
# Copy this file to `.env` and fill in real values before `docker compose up`.
# =============================================================================

# --- Public URL ---------------------------------------------------------------
# The full https URL the app will be served from. Used for CORS allowlist.
SITE_URL=https://auditee.example.com

# Host port the web container should publish on. 80 for plain HTTP, or any
# free port if you put Caddy / Traefik in front for TLS termination.
WEB_HTTP_PORT=80

# --- Database -----------------------------------------------------------------
POSTGRES_USER=auditee
POSTGRES_DB=auditee
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Auth (Clerk) -------------------------------------------------------------
# Get these from https://dashboard.clerk.com → your application → API keys.
# Add SITE_URL to "Allowed origins" in the Clerk dashboard, otherwise sign-in
# silently fails.
CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx

# --- Session / cookies --------------------------------------------------------
# A long random string. Generate with: openssl rand -hex 64
SESSION_SECRET=

# --- AI providers -------------------------------------------------------------
# OpenAI is required. Anthropic / OpenRouter are optional.
OPENAI_API_KEY=sk-xxxxx
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Optional: notifications --------------------------------------------------
# Leave blank to disable.
SENDGRID_API_KEY=
SMTP_HOST=
TWILIO_AUTH_TOKEN=

# --- Optional: GitHub integration --------------------------------------------
# Personal Access Token with `repo` scope, used by the CAPA-push-to-GitHub
# feature and the pre-audit source pull.
GITHUB_PAT=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
