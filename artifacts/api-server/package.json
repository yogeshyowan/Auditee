    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "adm-zip": "^0.5.17",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.6",
    "drizzle-orm": "catalog:",
