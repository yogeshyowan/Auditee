# --- Optional: forward captured leads to a Google Sheet ---
# Bind a Google Apps Script web app to your sheet (Extensions > Apps Script,
# deploy as Web app, "Execute as: Me", "Who has access: Anyone"). Paste the
# resulting /exec URL here and the API will append a row each time a brand-new
# lead is captured (one row per email per source).
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/<deployment-id>/exec
# Optional shared secret. If set, the API includes it in every webhook body and
# the Apps Script can reject calls that don't match.
# GOOGLE_SHEET_WEBHOOK_TOKEN=replace-with-a-long-random-string
